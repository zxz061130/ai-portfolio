# 把本文件复制成 .env，再填入你自己的密钥（.env 已被 .gitignore 排除，永远不要提交）
# 复制命令（PowerShell）：Copy-Item .env.example .env

# ① 密钥：谁是账号 —— 本周最大风险点
DEEPSEEK_API_KEY=sk-在这里粘贴你的密钥

# ② 平台：换平台只改这两行（通义：https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-plus）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ③ 可选：超时秒数
DEEPSEEK_TIMEOUT=60

# ④ 可选：单价（元 / 百万 token），去平台“价格/计费”页查，代码里不写死价格
# PRICE_INPUT_PER_M=2
# PRICE_OUTPUT_PER_M=8
