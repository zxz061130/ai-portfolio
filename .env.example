# 把本文件复制成 .env，再填入你自己的密钥（.env 已被 .gitignore 排除，永远不要提交）
# 复制命令（PowerShell）：Copy-Item .env.example .env

# ① 密钥：谁是账号
DEEPSEEK_API_KEY=

# ② 平台：换平台只改这两行
#    通义：https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-plus
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ③ 可选：超时秒数
DEEPSEEK_TIMEOUT=60

# ④ 可选：单价（元 / 百万 token），去平台“价格/计费”页查，代码里不写死价格
# PRICE_INPUT_PER_M=2
# PRICE_OUTPUT_PER_M=8

# ⑤ 本地模型（W5/W6 起用）
# LOCAL_MODEL=qwen2.5:0.5b      # 换成 qwen3:4b 就切到更大的本地模型
# LOCAL_HOST=127.0.0.1:11434    # 用 127.0.0.1，别用 localhost（可能解析到 IPv6）
# LOCAL_TIMEOUT=60              # 冷启动慢就调大，如 180
# LOCAL_THINK=1                 # qwen3 想让它输出思考链时打开（默认关）